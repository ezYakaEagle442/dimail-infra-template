#!/usr/bin/env bash

# environnement (parmi les répertoires env-(.*))
export DIMAIL_ENV=libvirt
export DIMAIL_ENVTYPE=dev
export DIMAIL_HOSTING=libvirt

# dimail-infra-config path, can override with any path if needed
export DIMAIL_CONFIG_PATH="$(dirname ${BASH_SOURCE[0]:-$0})"

# boilerplate, no need to modify unless you know why :)
source .env.common
