*.swp
*.swo
### Terraform ###
# Local .terraform directories
**/.terraform/*
*/.venv/
*/.venv/*

# .tfstate files
*.tfstate
*.tfstate.*

# python dust
**/__pycache__

# Crash log files
crash.log
crash.*.log
pers.access.token
access_keys.json

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars.json

# Exclude files with sensitive information that should not be shared (excepts for the example file)
.env*
!.env.common
!.env.example.*

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

[docs/admin/docs/architecture-upsay/]
# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
**/host_vars/main.yml
inventory.ini
# End of https://www.toptal.com/developers/gitignore/api/terraform
vaultpasswd_file

# IDE misc
.idea/
.vscode/

**/.DS_Store

/40_ansible_single/.venv/
/40_ansible_single/venv/

# libvirt work files
30_libvirt/*.qcow2
30_libvirt/ansible/hosts
30_libvirt/ssh_key.pub

assets/

.ansible/**/*
outputs/**/*
# Ignore generated architecture exports (local, renamed)
30_vmware/generated-upsay-archi/
network/*
