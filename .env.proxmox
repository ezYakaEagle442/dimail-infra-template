#!/usr/bin/env bash

# environnement (parmi les répertoires env-(.*))
export DIMAIL_ENV=proxmoxdev
export DIMAIL_ENVTYPE=dev
export DIMAIL_HOSTING=proxmox

# proxmox provider variables

export PROXMOX_VE_ENDPOINT="https://192.168.122.2:8006/"
export PROXMOX_VE_API_TOKEN="root@pam!Administrator=adb39634-453e-4ce0-8337-2eccf104859d"
export PROXMOX_VE_USERNAME="root@pam"
export PROXMOX_VE_PASSWORD="totototo"
export PROXMOX_VE_SSH_USERNAME="root"
export PROXMOX_VE_INSECURE="true"

# dimail-infra-config path, can override with any path if needed
export DIMAIL_CONFIG_PATH="$(dirname ${BASH_SOURCE[0]:-$0})"

# boilerplate, no need to modify unless you know why :)
source .env.common
